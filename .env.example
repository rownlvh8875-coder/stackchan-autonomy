# Copy to .env locally. Never commit the real .env file.
# Mock mode requires no key. Configure model according to your account and current docs.
OPENAI_API_KEY=
STACKCHAN_OPENAI_MODEL=
STACKCHAN_CLOUD_ENABLED=false
STACKCHAN_IMAGE_TRANSMISSION=false
STACKCHAN_AUDIO_TRANSMISSION=false
# Voice cloud stays opt-in; use models/voice supported by your own account.
# STACKCHAN_STT_MODEL=<configured transcription model>
# STACKCHAN_TTS_MODEL=<configured speech model>
# STACKCHAN_TTS_VOICE=<configured voice>
STACKCHAN_VOICE_CAPTURE_MS=5000
STACKCHAN_HARDWARE_ENABLED=false
STACKCHAN_DRY_RUN=true
STACKCHAN_OBSERVE_INTERVAL_S=30
STACKCHAN_REQUESTS_PER_MINUTE=2
STACKCHAN_REQUESTS_PER_HOUR=30
STACKCHAN_REQUESTS_PER_DAY=100
# Same absolute local DB/resource/namespace/limits for all participating processes.
# STACKCHAN_STATE_PATH=C:/StackChanData/autonomy.sqlite3
STACKCHAN_CONTROL_RESOURCE=stackchan:default
STACKCHAN_LEASE_TTL_S=10
STACKCHAN_BUDGET_NAMESPACE=openai:default
STACKCHAN_MCP_URL=http://127.0.0.1:8767/mcp
# Optional metadata-only SQLite. Parent directory must exist.
# STACKCHAN_MEMORY_PATH=.local/memory.sqlite
