# Development target only. This generated partition layout is NOT K151 stock.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# No Wi-Fi credentials, API keys, OTA, or flashing options are baked in.

# Keep SCFG USB Serial/JTAG separate from console and logs.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
